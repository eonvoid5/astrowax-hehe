# ChatGPT-style AI (recommended)
# Keep this key only in your VPS environment / Vercel Environment Variables.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local AI fallback (no API key, requires Ollama on the same VPS)
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
